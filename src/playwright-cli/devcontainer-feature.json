{
    "name": "Playwright CLI with Chrome",
    "id": "playwright-cli",
    "version": "1.0.1",
    "description": "Installs the latest Playwright CLI and Google Chrome with system dependencies",
    "containerEnv": {
        "PLAYWRIGHT_BROWSERS_PATH": "/opt/ms-playwright",
        "PLAYWRIGHT_MCP_SANDBOX": "0"
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils",
        "ghcr.io/devcontainers/features/node"
    ]
}